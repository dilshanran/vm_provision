# Azure example tfvars (nausani_vm)
#
# GitHub: Environment secret TF_VARS_AZURE (nausani_vm)
# Local:  terraform.tfvars (gitignored), then:
#   ../../scripts/init-backend.sh azure
# Workflow: environment = nausani_vm, cloud = azure
#
# Image defaults to Amazon Linux 2023 Gen2 (Ntegral marketplace).
# Marketplace plan fields below are required for that image.

cloud_provider = "azure"
region         = "eastus2"

tags = {
  Team        = "unix"
  Application = "nausani"
  CostCentre  = "IT-OPS-001"
  Environment = "nausani_vm"
}

vms = {
  "app-01" = {
    hostname      = "SYSENG-UNIX-NAUSANI-01"
    instance_type = "Standard_D2s_v3"
    subnet_id     = "/subscriptions/<sub-id>/resourceGroups/<rg>/providers/Microsoft.Network/virtualNetworks/<vnet>/subnets/<subnet>"
  }
}

azure_config = {
  resource_group_name = "SYSENG-VNET-Dev-rg"
  admin_username      = "unixadmin"
  ssh_public_key      = "ssh-rsa AAAA... your-key"
  enable_public_ip    = false

  # Marketplace image + plan (AL2023 Gen2)
  image_publisher = "ntegralinc1586961136942"
  image_offer     = "ntg_amzn_linux_2023"
  image_sku       = "ntg_amzn_linux_2023_gen2"
  image_version   = "latest"
  plan_name       = "ntg_amzn_linux_2023_gen2"
  plan_product    = "ntg_amzn_linux_2023"
  plan_publisher  = "ntegralinc1586961136942"

  # Nasuni syslog collector. enable_syslog_collector bootstraps rsyslog on
  # UDP 514 via cloud-init; enable_monitor_agent adds the managed identity
  # and Azure Monitor Agent that ship those messages to Log Analytics.
  enable_syslog_collector        = true
  enable_monitor_agent           = true
  syslog_source_address_prefixes = ["10.0.0.0/24"] # Nasuni Edge Appliances only
}

# Workspace receiving syslog. May live in another subscription.
# Omit to provision the collector without the Data Collection Rule.
log_analytics_workspace_id = "/subscriptions/<sub-id>/resourceGroups/<rg>/providers/Microsoft.OperationalInsights/workspaces/Syseng-AVD-log"

# Do not set aws_config when cloud_provider = "azure"
