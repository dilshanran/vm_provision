# AWS example tfvars (uat)
#
# GitHub: Environment secret TF_VARS_AWS (uat)
# Local:  terraform_aws.tfvars (gitignored), then:
#   ../../scripts/init-backend.sh aws
# Workflow: cloud = aws
#
# Omit ami_id to auto-select latest Amazon Linux 2023.

cloud_provider = "aws"
region         = "us-east-1"

tags = {
  Team        = "unix"
  Application = "myapp"
  CostCentre  = "IT-OPS-001"
  Environment = "uat"
}

vms = {
  "app-01" = {
    hostname      = "SYSENG-UNIX-UAT-01"
    instance_type = "t3.medium"
    subnet_id     = "subnet-xxxxxxxx"
  }
}

aws_config = {
  vpc_security_group_ids = ["sg-xxxxxxxx"]
  root_volume_size       = 30
  root_volume_type       = "gp3"
  # ami_id               = "ami-xxxxxxxx"   # optional
  # key_name             = "unix-team-uat" # optional
  # iam_instance_profile = "..."            # optional
}

# Do not set azure_config when cloud_provider = "aws"
