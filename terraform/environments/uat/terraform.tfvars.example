cloud_provider = "aws"
region         = "us-east-1"

# ── Mandatory tags — pipeline fails if any are missing ────────────────────
tags = {
  Team        = "unix"
  Application = "myapp"
  CostCentre  = "IT-OPS-001"
}

vms = {
  "app-01" = {
    hostname      = "uat-app-01"
    instance_type = "t3.large"
    subnet_id     = "subnet-xxxxxxxx"
  }
}

aws_config = {
  ami_id                 = "ami-0c7217cdde317cfec"
  vpc_security_group_ids = ["sg-xxxxxxxx"]
  key_name               = "unix-team-uat"
}
