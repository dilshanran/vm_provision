# Partial remote state backend.
#
# Do not edit this file to switch clouds. Select backend at init time:
#
#   ../../scripts/init-backend.sh aws
#   ../../scripts/init-backend.sh azure
#
# Default type is s3. Azure writes a gitignored backend_override.tf so this
# file stays unchanged across AWS ↔ Azure switches.
terraform {
  backend "s3" {}
}
