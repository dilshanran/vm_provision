# =============================================================================
# AWS — example tfvars for stage
#
# Usage:
#   - GitHub: paste into Environment secret TF_VARS (stage)
#   - Local:  copy to terraform.tfvars (gitignored)
#
# Backend: ../../scripts/init-backend.sh aws
# Workflow cloud input: aws
#
# AMI: omit ami_id to auto-select latest Amazon Linux 2023
# =============================================================================

cloud_provider = "aws"
region         = "us-east-1"

tags = {
  Team        = "unix"
  Application = "myapp"
  CostCentre  = "IT-OPS-001"
  Environment = "stage"
}

vms = {
  "app-01" = {
    hostname      = "SYSENG-UNIX-STAGE-01"
    instance_type = "t3.medium"
    subnet_id     = "subnet-xxxxxxxx"
  }
}

aws_config = {
  vpc_security_group_ids = ["sg-xxxxxxxx"]
  root_volume_size       = 30
  root_volume_type       = "gp3"
  # ami_id               = "ami-xxxxxxxx"     # optional
  # key_name             = "unix-team-stage"  # optional
  # iam_instance_profile = "..."              # optional
}

# Do not set azure_config when cloud_provider = "aws"
