# Copy to terraform.tfvars and fill in values for your cloud / network.

cloud_provider = "aws"
region         = "us-east-1"

# ── Mandatory tags — pipeline fails if any are missing ────────────────────
tags = {
  Team        = "unix"
  Application = "myapp"
  CostCentre  = "IT-OPS-001"
}

vms = {
  "app-01" = {
    hostname      = "dev-app-01"
    instance_type = "t3.medium"
    subnet_id     = "subnet-xxxxxxxx"
  }
}

aws_config = {
  ami_id                 = "ami-0c7217cdde317cfec" # Ubuntu 22.04 LTS us-east-1
  vpc_security_group_ids = ["sg-xxxxxxxx"]
  key_name               = "unix-team-dev"
}

